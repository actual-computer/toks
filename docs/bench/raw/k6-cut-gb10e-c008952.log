  * prio << k | pos key, the linked array, bytepair round one, 8-slot 64-byte buckets homed by Fibonacci
  * hashing); new here: the rest-scan overlapped with the probes, the scalar xor/min-tree probe, NID/PID.
  *
- * A leaf: x0-x17, v0-v7, v29 (a probe count), v30 (t), v31 (a); no stack.
+ * A leaf: x0-x17, v0-v7, v16 (round one's survivor list), v27 (the pair filter), v28 (len), v29 (a probe count),
+ * v30 (t), v31 (a); no stack.
  */
 #include "asm.h"
 #include "layout.h"
@@ -782,9 +783,22 @@
         ldr     x12, [x0, #TT_PAIRF]
         fmov    d27, x12                        /* the pair filter (bpe.h bpe_pf_bits) */
         MERGE_PARAMS
-        sub     x13, x16, #1                    /* pairs */
+        /* round one. A pair of two bytes reads bytepair[]; a pair holding a token probes the merge table, except
+         * one holding a premerged char's token (BYT 0x300): most of those have no merge (kernels.md 5.1, the pair
+         * filter), so pass 1 only computes its filter bits, without a branch on them, and puts its position on a
+         * survivor list when both are set (the store always happens, the end moves by the bit); pass 2 probes the
+         * survivors. As a branch, the bits (set for 20-30% of zh pairs, in no pattern) mispredicted for 16-24 ns a
+         * zh piece over 15 bytes. The list (u32, at most n - 1) sits at x3 + 22 len, after SYM and BYT here and
+         * inside the work area for toks_k6_merge_neon's caller-held symbols: within TOKS_BPE_WORK_BYTES(len). */
+        add     x13, x3, x2, lsl #4
+        add     x13, x13, x2, lsl #2
+        add     x13, x13, x2, lsl #1
+        add     x13, x13, #3
+        and     x13, x13, #~3                   /* the survivor list's end, at its start */
+        fmov    d16, x13
         mov     x15, #0
-11:     cmp     x15, x13
+11:     add     x0, x15, #1
+        cmp     x0, x16
         b.hs    12f
         add     x1, x17, x2, lsl #2
         add     x1, x1, x15, lsl #1
